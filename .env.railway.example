# ══════════════════════════════════════════════════════════════════════════════
# .env.railway.example — Secretos para reconstruir la infraestructura Railway
#
# INSTRUCCIONES:
#   1. cp .env.railway.example .env.railway
#   2. Rellenar cada valor
#   3. El archivo .env.railway está en .gitignore — NUNCA subirlo al repo
# ══════════════════════════════════════════════════════════════════════════════

# ── Supabase ──────────────────────────────────────────────────────────────────
# Contraseña del usuario postgres en Supabase
# Encontrar en: Supabase Dashboard → Settings → Database → Database password
SUPABASE_PASSWORD=

# Host del connection pooler (modo pooler, distinto del host de conexión directa).
# Encontrar en: Supabase Dashboard → Settings → Database → Connection pooling → Host
SUPABASE_POOLER_HOST=

# Project ref de Supabase (va como parte del username en el modo pooler:
# postgres.<project_ref>). Encontrar en: Supabase Dashboard → Settings → General
SUPABASE_PROJECT_REF=

# ── JWT ───────────────────────────────────────────────────────────────────────
# Clave secreta para firmar tokens (mínimo 32 caracteres)
# Generar con: openssl rand -base64 32
JWT_SECRET_KEY=

# ── Gmail SMTP ────────────────────────────────────────────────────────────────
# App Password de Google (16 caracteres con espacios)
# Crear en: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=

# ── Frontend ──────────────────────────────────────────────────────────────────
# URL de Netlify donde está desplegado el frontend
NETLIFY_URL=https://startling-frangollo-fa4cb9.netlify.app
