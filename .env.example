# ══════════════════════════════════════════════════════════════════════════════
# .env.example — Sagrada Familia
#
# INSTRUCCIONES:
#   1. Copiar este archivo:  cp .env.example .env
#   2. Rellenar cada valor marcado con <...>
#   3. NUNCA subir .env al repositorio (.gitignore ya lo excluye)
#
# docker-compose lee este archivo automáticamente si se llama '.env'
# y está en la misma carpeta que docker-compose.yml.
# ══════════════════════════════════════════════════════════════════════════════


# ── SQL Server ────────────────────────────────────────────────────────────────
# Contraseña del usuario 'sa' (System Administrator).
# Requisitos de SQL Server: mínimo 8 caracteres, debe incluir
# mayúscula, minúscula, dígito y símbolo especial.
SA_PASSWORD=<TuPasswordSeguro123!>


# ── JWT ───────────────────────────────────────────────────────────────────────
# Clave secreta para firmar los tokens JWT (algoritmo HS256).
# Debe tener al menos 32 caracteres (256 bits).
# Generar una clave aleatoria segura con:
#   openssl rand -base64 32
JWT_SECRET_KEY=<clave_secreta_minimo_32_caracteres_aleatoria>


# ── Docker Hub (solo para docker-compose.prod.yml) ───────────────────────────
# Tu nombre de usuario en hub.docker.com.
# Solo necesario si desplegas con docker-compose.prod.yml (imágenes precompiladas).
DOCKERHUB_USER=<tu_usuario_dockerhub>


# ── SMTP — Gmail ──────────────────────────────────────────────────────────────
# Usar una App Password de Google, NO la contraseña de la cuenta.
# Crear en: https://myaccount.google.com/apppasswords
# (Requiere verificación en dos pasos activada en la cuenta de Gmail)
SMTP_FROM_EMAIL=<tu_correo@gmail.com>
SMTP_USERNAME=<tu_correo@gmail.com>
SMTP_PASSWORD=<xxxx xxxx xxxx xxxx>
