          <mxGeometry x="150" y="80" width="1220" height="850" as="geometry" />
        </mxCell>

        <!-- ===== CI/CD: GitHub + Actions ===== -->
        <mxCell id="github" value="&lt;b&gt;GitHub + GitHub Actions (CI/CD)&lt;/b&gt;&#xa;Push a rama main → workflow ejecuta:&#xa;· docker build + push imágenes → ACR&#xa;· npm build + deploy SPA → Static Web Apps"
          style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f6f8fa;strokeColor=#24292e;fontSize=9;"
