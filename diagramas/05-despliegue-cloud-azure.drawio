          <mxGeometry x="15" y="50" width="400" height="90" as="geometry" />
        </mxCell>

        <!-- ===== Azure Container Registry ===== -->
        <mxCell id="acr" value="&lt;b&gt;Azure Container Registry (ACR)&lt;/b&gt;&#xa;Imágenes Docker versionadas:&#xa;sagrada-api:latest · sagrada-predict:latest · sagrada-web:latest"
          style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8f0;strokeColor=#ea580c;fontSize=9;"
          vertex="1" parent="azure">
          <mxGeometry x="435" y="50" width="350" height="90" as="geometry" />
        </mxCell>

        <!-- ===== Azure Static Web Apps ===== -->
        <mxCell id="swa" value="&lt;b&gt;Azure Static Web Apps&lt;/b&gt;&#xa;Angular 22 SPA (build producción)&#xa;CDN global · HTTPS automático&#xa;Proxy /api/* → Container Apps (api)"
          style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1e88e5;fontSize=9;strokeWidth=2;"
          vertex="1" parent="azure">
          <mxGeometry x="830" y="50" width="370" height="110" as="geometry" />
        </mxCell>

        <!-- ===== Azure Container Apps Environment ===== -->
        <mxCell id="cont_env" value="&lt;&lt;Azure Container Apps Environment&gt;&gt;"
          style="swimlane;startSize=35;fillColor=#f0fdf4;strokeColor=#16a34a;fontStyle=1;fontSize=11;whiteSpace=wrap;html=1;strokeWidth=2;"
          vertex="1" parent="azure">
          <mxGeometry x="15" y="170" width="790" height="430" as="geometry" />
        </mxCell>

        <!-- Container App: api -->
        <mxCell id="api_app" value="&lt;&lt;Container App&gt;&gt; api"
          style="swimlane;startSize=35;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;whiteSpace=wrap;html=1;"
          vertex="1" parent="cont_env">
          <mxGeometry x="15" y="45" width="760" height="160" as="geometry" />
        </mxCell>
        <mxCell id="api_content" value="&lt;b&gt;SagradaFamilia.API (.NET 8)&lt;/b&gt;&#xa;Ingress HTTPS público · Escala horizontal automática&#xa;Variables de entorno inyectadas desde Azure Key Vault&#xa;(JWT · SMTP · ConnectionString via Managed Identity)&#xa;Al iniciar: aplica migraciones EF Core + Seeders automáticamente"
          style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#82b366;fontSize=9;align=left;spacingLeft=8;verticalAlign=top;spacingTop=5;"
          vertex="1" parent="api_app">
          <mxGeometry x="10" y="40" width="740" height="108" as="geometry" />
        </mxCell>

        <!-- Container App: predict -->
        <mxCell id="predict_app" value="&lt;&lt;Container App&gt;&gt; predict"
          style="swimlane;startSize=35;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=11;whiteSpace=wrap;html=1;"
          vertex="1" parent="cont_env">
          <mxGeometry x="15" y="220" width="760" height="160" as="geometry" />
        </mxCell>
        <mxCell id="pred_content" value="&lt;b&gt;sagrada-predict-api (Python FastAPI + Prophet)&lt;/b&gt;&#xa;Ingress solo interno (accesible únicamente desde el mismo Environment)&#xa;:8000 (no expuesto a internet) · Healthcheck: GET /health&#xa;PROPHET_MIN_MEDIDAS=3 · PROPHET_INTERVAL_WIDTH=0.80&#xa;NET_BACKEND_URL=http://api (DNS interno del Environment)"
          style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#9673a6;fontSize=9;align=left;spacingLeft=8;verticalAlign=top;spacingTop=5;"
          vertex="1" parent="predict_app">
          <mxGeometry x="10" y="40" width="740" height="108" as="geometry" />
        </mxCell>

        <!-- Nota de red interna del Environment -->
        <mxCell id="env_note" value="Red interna del Environment: api y predict se descubren por nombre de servicio (DNS interno)"
