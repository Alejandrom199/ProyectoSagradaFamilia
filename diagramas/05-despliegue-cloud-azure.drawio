        <!-- ===== Azure Key Vault ===== -->
        <mxCell id="kv" value="&lt;b&gt;Azure Key Vault&lt;/b&gt;&#xa;Secrets:&#xa;JWT_SECRET_KEY · SA_PASSWORD&#xa;SMTP_USERNAME · SMTP_PASSWORD&#xa;ConnectionString (completo)"
