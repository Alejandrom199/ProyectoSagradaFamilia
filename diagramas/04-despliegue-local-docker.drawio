          vertex="1" parent="1">
          <mxGeometry x="150" y="80" width="1170" height="870" as="geometry" />
        </mxCell>

        <!-- ===== DOCKER NETWORK: sagrada_net ===== -->
        <mxCell id="net" value="&lt;&lt;Docker Network: bridge&gt;&gt;&#xa;sagrada_net"
