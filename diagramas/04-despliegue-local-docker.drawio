<mxfile host="app.diagrams.net">
  <diagram name="Despliegue Local - Docker Compose" id="deploy-local">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TÍTULO -->
        <mxCell id="title" value="Diagrama de Despliegue Local — SagradaFamilia (Docker Compose)"
          style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=16;fontStyle=1;"
          vertex="1" parent="1">
          <mxGeometry x="100" y="20" width="1200" height="40" as="geometry" />
        </mxCell>

        <!-- ===== BROWSER (externo) ===== -->
        <mxCell id="browser" value="&lt;b&gt;Navegador&lt;/b&gt;&#xa;(Cliente)"
