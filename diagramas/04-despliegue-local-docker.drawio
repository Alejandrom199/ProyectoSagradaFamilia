          vertex="1" parent="1">
          <mxGeometry x="25" y="340" width="90" height="75" as="geometry" />
        </mxCell>

        <!-- ===== HOST MACHINE ===== -->
        <mxCell id="host" value="&lt;&lt;host&gt;&gt;&#xa;Máquina Host"
